# Caddyfile.dev — dev-only, disposable. Puts every dev service (frontend:3000,
# backend:8080 including the AI Connector's /oauth, /.well-known, /mcp routes,
# minio:9000, labproxy:8081) behind one origin/port, so only Caddy needs a
# published host port — see docker-compose.dev.yml. Mirrors the routing shape
# of the production Caddyfile (including the /lab-ws/* prefix-strip trick for
# labproxy) except this listens on plain :80, not a real domain.
:80 {
	reverse_proxy /api/* backend:8080
	reverse_proxy /oauth/* backend:8080
	reverse_proxy /.well-known/* backend:8080
	reverse_proxy /mcp backend:8080

	# Terminal WebSocket + live-preview relay (frontend connects to
	# NEXT_PUBLIC_LAB_PROXY_URL=ws://localhost/lab-ws). labproxy only serves
	# "/ws", "/health", and "/preview/*", so the "/lab-ws" prefix is stripped
	# before proxying — same as the production Caddyfile.
	handle_path /lab-ws/* {
		reverse_proxy labproxy:8081
	}

	# labproxy down/unreachable: Caddy's default 502 body is empty, so the IDE and
	# App iframes would render a blank pane. Show a readable message instead.
	handle_errors {
		@labws path /lab-ws/*
		handle @labws {
			header Content-Type "text/html; charset=utf-8"
			respond "<!doctype html><meta name=viewport content='width=device-width'><body style='font-family:system-ui;padding:2rem;color:#555'><p>The lab environment is unavailable right now. Reload in a few seconds.</p></body>" {err.status_code}
		}
	}

	reverse_proxy /mindforge/* minio:9000

	reverse_proxy frontend:3000
}

# Live preview subdomains (dev) — mirrors the production Caddyfile's
# wildcard preview block, minus TLS/DNS-01: docker-compose.dev.yml sets
# LABPROXY_PREVIEW_DOMAIN=localhost, and *.localhost resolves to loopback in
# Chrome/Edge/Firefox with zero /etc/hosts or DNS setup, and is treated as a
# secure context (so the __Host-prefixed preview cookie still works) even
# over plain HTTP — see backend/cmd/labproxy/preview_host.go. No path
# stripping, same reasoning as the production block.
*.localhost:80 {
	reverse_proxy labproxy:8081
}
