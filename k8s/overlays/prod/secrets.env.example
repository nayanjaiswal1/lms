# Copy to k8s/overlays/prod/secrets.env and fill in every value before
# deploying. NEVER commit secrets.env — it is in .gitignore. Consumed by this
# overlay's kustomization.yaml secretGenerator, which produces the
# "mindforge-secrets" Secret every base manifest references via envFrom.
# Same key list as .env.prod.example / k8s/base/secret.example.yaml — see
# those for what each value is used for.

POSTGRES_USER=mindforge
POSTGRES_PASSWORD=change_me_very_strong_prod_password
POSTGRES_DB=mindforge_prod
DATABASE_URL=postgres://mindforge:change_me_very_strong_prod_password@postgres:5432/mindforge_prod
LABPROXY_DB_URL=postgres://mindforge:change_me_very_strong_prod_password@postgres:5432/mindforge_prod

REDIS_PASSWORD=change_me_strong_redis_password
REDIS_URL=redis://:change_me_strong_redis_password@redis:6379/0
LABPROXY_REDIS_URL=redis://:change_me_strong_redis_password@redis:6379/0

JWT_SECRET=change_me_prod_jwt_secret_min_32_bytes_random_string
COOKIE_SECRET=change_me_prod_cookie_secret_min_32_bytes_random_str
ENCRYPTION_KEY=change_me_prod_encryption_key_exactly_32bytes!!
LABPROXY_JWT_SECRET=change_me_prod_jwt_secret_min_32_bytes_random_string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SMTP_USER=your_smtp_api_key_or_username
SMTP_PASS=your_smtp_api_key_or_password

MINIO_ROOT_USER=mindforge
MINIO_ROOT_PASSWORD=change_me_very_strong_minio_password
MINIO_ACCESS_KEY=mindforge
MINIO_SECRET_KEY=change_me_very_strong_minio_password

LLM_API_KEY=

ANTHROPIC_API_KEY=
