# ══════════════════════════════════════════════════════════════════════════════
# MindForge — Production Environment Variables
# Copy this file to .env.prod and fill in ALL values before deploying.
# NEVER commit .env.prod — it is in .gitignore.
# Full rationale for every variable: see ENV_VARS.md
# ══════════════════════════════════════════════════════════════════════════════

# ─── Domain ───────────────────────────────────────────────────────────────────
DOMAIN=app.yourdomain.com                      # Required

# Live lab preview subdomains (p<port>-<sessionID>.<this>, one origin per
# port+session — see backend/cmd/labproxy/host.go). Must be a subdomain of
# DOMAIN (e.g. labs.app.yourdomain.com) so SameSite=Lax still holds for the
# preview redirect. Needs a wildcard cert, which needs DNS-01 issuance (a
# single wildcard label can't be proven via HTTP-01) — CADDY_DNS_PROVIDER/
# CADDY_DNS_API_TOKEN below configure that for the Caddy build in
# Dockerfile.caddy. See docs/infrastructure.md and ENV_VARS.md.
LABPROXY_PREVIEW_DOMAIN=labs.app.yourdomain.com    # Required
CADDY_DNS_PROVIDER=cloudflare                  # Required — caddy-dns module name (github.com/caddy-dns/<this>)
CADDY_DNS_API_TOKEN=change_me_dns_zone_edit_token   # Required — zone-edit token for CADDY_DNS_PROVIDER

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=mindforge                        # Required
POSTGRES_PASSWORD=change_me_very_strong_prod_password    # Required
POSTGRES_DB=mindforge_prod                     # Required
DATABASE_URL=postgres://mindforge:change_me_very_strong_prod_password@postgres:5432/mindforge_prod    # Required

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_strong_redis_password    # Required
REDIS_URL=redis://:change_me_strong_redis_password@redis:6379/0    # Required

# ─── JWT / Session ────────────────────────────────────────────────────────────
JWT_SECRET=change_me_prod_jwt_secret_min_32_bytes_random_string      # Required
COOKIE_SECRET=change_me_prod_cookie_secret_min_32_bytes_random_str   # Required
ENCRYPTION_KEY=change_me_prod_encryption_key_exactly_32bytes!!       # Required

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=30m
EMAIL_VERIFICATION_TTL=24h

# ─── Tenant ───────────────────────────────────────────────────────────────────
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001    # Required

# ─── Object Storage (MinIO) ────────────────────────────────────────────────────
MINIO_ROOT_USER=mindforge                                  # Required
MINIO_ROOT_PASSWORD=change_me_very_strong_minio_password    # Required
MINIO_ACCESS_KEY=mindforge                                 # Required — must match MINIO_ROOT_USER
MINIO_SECRET_KEY=change_me_very_strong_minio_password       # Required — must match MINIO_ROOT_PASSWORD
MINIO_ENDPOINT=minio:9000                                  # Required
MINIO_PUBLIC_ENDPOINT=app.yourdomain.com                   # Required — must match DOMAIN
MINIO_BUCKET=mindforge                                     # Required
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=true                                  # Required

# ─── Code Execution (Piston) ───────────────────────────────────────────────────
PISTON_URL=http://piston:2000
PISTON_TIMEOUT=30s

# ─── Labs (terminal sandbox relay) ─────────────────────────────────────────────
LABPROXY_DB_URL=postgres://mindforge:change_me_very_strong_prod_password@postgres:5432/mindforge_prod    # Required — mirror DATABASE_URL
LABPROXY_REDIS_URL=redis://:change_me_strong_redis_password@redis:6379/0                                 # Required — mirror REDIS_URL
LABPROXY_JWT_SECRET=change_me_prod_jwt_secret_min_32_bytes_random_string                                 # Required — must equal JWT_SECRET
LABPROXY_JWT_ISSUER=mindforge-labproxy

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
FRONTEND_URL=https://app.yourdomain.com        # Required — must match DOMAIN

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.postmarkapp.com                 # Required
SMTP_PORT=587                                  # Optional — default 587
SMTP_USER=your_smtp_api_key_or_username        # Required
SMTP_PASS=your_smtp_api_key_or_password        # Required
EMAIL_FROM=noreply@yourdomain.com              # Required

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=production                                 # Required

# ─── Backups ────────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14                       # Optional — default 14
BACKUP_ALERT_WEBHOOK=                          # Optional

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://app.yourdomain.com        # Required
NEXT_PUBLIC_APP_URL=https://app.yourdomain.com        # Required
NEXT_PUBLIC_MEDIA_URL=https://app.yourdomain.com      # Required — must match MINIO_PUBLIC_ENDPOINT
NEXT_PUBLIC_LAB_PROXY_URL=wss://app.yourdomain.com/lab-ws    # Required
BACKEND_URL=http://backend:8080

NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=false

ANTHROPIC_API_KEY=

# ─── LLM Provider ───────────────────────────────────────────────────────────────
LLM_PROVIDER=disabled                          # anthropic | gemini | disabled
LLM_API_KEY=                                   # Required when LLM_PROVIDER != disabled
LLM_MODEL=claude-sonnet-4-6
LLM_BASE_URL=
LLM_TIMEOUT=30s

# ─── Payments (optional) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                             # Optional
STRIPE_PUBLISHABLE_KEY=                        # Optional
STRIPE_WEBHOOK_SECRET=                         # Required once STRIPE_SECRET_KEY is set
RAZORPAY_KEY_ID=                               # Optional
RAZORPAY_KEY_SECRET=                           # Optional
RAZORPAY_WEBHOOK_SECRET=                       # Required once RAZORPAY_KEY_ID is set
PAYMENTS_DEFAULT_PROVIDER=                     # Optional — stripe | razorpay
PAYMENTS_CURRENCY=USD                          # Optional — default USD
