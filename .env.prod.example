# ══════════════════════════════════════════════════════════════════════════════
# MindForge — Production Environment Variables
# Copy this file to .env.prod and fill in ALL values before deploying.
# NEVER commit .env.prod — it is in .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Domain ───────────────────────────────────────────────────────────────────
# Used by Caddy to obtain a TLS certificate via ACME (Let's Encrypt).
# Must be a real domain with DNS pointing to this server before deploying.

DOMAIN=app.yourdomain.com                      # Required — your production domain

# ─── Database ─────────────────────────────────────────────────────────────────
# Postgres runs inside Docker (no external port exposure).
# Use a strong, randomly generated password.

POSTGRES_USER=mindforge                        # Required
POSTGRES_PASSWORD=change_me_very_strong_prod_password    # Required — use openssl rand -hex 32
POSTGRES_DB=mindforge_prod                     # Required

DATABASE_URL=postgres://mindforge:change_me_very_strong_prod_password@postgres:5432/mindforge_prod    # Required

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis runs inside Docker (no external port exposure). Use a password in prod.

REDIS_PASSWORD=change_me_strong_redis_password    # Required in prod
REDIS_URL=redis://:change_me_strong_redis_password@redis:6379/0    # Required

# ─── JWT / Session ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# All three must be different, min 32 bytes, and NOT the same as dev values.

JWT_SECRET=change_me_prod_jwt_secret_min_32_bytes_random_string      # Required
COOKIE_SECRET=change_me_prod_cookie_secret_min_32_bytes_random_str   # Required
ENCRYPTION_KEY=change_me_prod_encryption_key_exactly_32bytes!!       # Required — exactly 32 bytes

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=30m
EMAIL_VERIFICATION_TTL=24h

# ─── Tenant ───────────────────────────────────────────────────────────────────
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001    # Required

# ─── Object Storage (MinIO) ────────────────────────────────────────────────────
# Runs inside Docker (no external port exposure) — reached internally by the
# backend, and by browsers via Caddy, which proxies the bucket path so
# presigned URL signatures (signed against MINIO_PUBLIC_ENDPOINT) stay valid.

MINIO_ROOT_USER=mindforge                                  # Required
MINIO_ROOT_PASSWORD=change_me_very_strong_minio_password    # Required — use openssl rand -hex 32
MINIO_ACCESS_KEY=mindforge                                 # Required — must match MINIO_ROOT_USER
MINIO_SECRET_KEY=change_me_very_strong_minio_password       # Required — must match MINIO_ROOT_PASSWORD
MINIO_ENDPOINT=minio:9000                                  # Required — internal Docker hostname
MINIO_PUBLIC_ENDPOINT=app.yourdomain.com                   # Required — must match DOMAIN (no scheme, no port)
MINIO_BUCKET=mindforge                                     # Required — must match the bucket path in Caddyfile
MINIO_USE_SSL=false                                        # Internal traffic — Caddy terminates TLS
MINIO_PUBLIC_USE_SSL=true                                  # Required — presigned/public URLs use https

# ─── Code Execution (Piston) ────────────────────────────────────────────────────
# Runs inside Docker, privileged (sandboxes untrusted user code). No external
# port exposure — reached internally by the backend only.

PISTON_URL=http://piston:2000
PISTON_TIMEOUT=30s

# ─── Labs (terminal sandbox relay) ──────────────────────────────────────────────
# labproxy is a separate service/binary. LABPROXY_JWT_SECRET must equal
# JWT_SECRET above — the backend mints lab session tokens that labproxy verifies.

LABPROXY_DB_URL=postgres://mindforge:change_me_very_strong_prod_password@postgres:5432/mindforge_prod    # Required — mirror DATABASE_URL
LABPROXY_REDIS_URL=redis://:change_me_strong_redis_password@redis:6379/0                                 # Required — mirror REDIS_URL
LABPROXY_JWT_SECRET=change_me_prod_jwt_secret_min_32_bytes_random_string                                 # Required — must equal JWT_SECRET
LABPROXY_JWT_ISSUER=mindforge-labproxy

# ─── OAuth ────────────────────────────────────────────────────────────────────
# Callback URLs for production:
#   Google: https://app.yourdomain.com/api/auth/google/callback
#   GitHub: https://app.yourdomain.com/api/auth/github/callback

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

FRONTEND_URL=https://app.yourdomain.com        # Required — must match DOMAIN

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Use a transactional email provider: Postmark, Resend, SendGrid, SES, etc.
# For Postmark: SMTP_HOST=smtp.postmarkapp.com SMTP_PORT=587

SMTP_HOST=smtp.postmarkapp.com                 # Required
SMTP_PORT=587                                  # Optional — default 587
SMTP_USER=your_smtp_api_key_or_username        # Required
SMTP_PASS=your_smtp_api_key_or_password        # Required
EMAIL_FROM=noreply@yourdomain.com              # Required — must be verified with your provider

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=production                                 # Required — enables Secure cookies, strict logging

# ─── Backups (scripts/backup-prod.sh, scripts/restore-prod.sh) ────────────────
BACKUP_RETENTION_DAYS=14                       # Optional — days to keep superseded backup chains
BACKUP_ALERT_WEBHOOK=                          # Optional — Slack/Discord/generic incoming-webhook URL,
                                                # posted to if a backup or restore run fails

# ─── Frontend ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* values are baked into the client bundle at build time (see
# docker-compose.prod.yml frontend `build.args`) — changing them requires a
# rebuild, not just a container restart.
NEXT_PUBLIC_API_URL=https://app.yourdomain.com        # Required — public backend URL
NEXT_PUBLIC_APP_URL=https://app.yourdomain.com        # Required — public frontend URL
NEXT_PUBLIC_MEDIA_URL=https://app.yourdomain.com      # Required — must match MINIO_PUBLIC_ENDPOINT's scheme+host
NEXT_PUBLIC_LAB_PROXY_URL=wss://app.yourdomain.com/lab-ws    # Required — must match DOMAIN, wss:// not ws://
BACKEND_URL=http://backend:8080                        # Server-to-server (uses internal Docker hostname)

# Anthropic API key — used server-side only by the frontend for resume parsing.
ANTHROPIC_API_KEY=

# ─── LLM Provider (backend — course generation, revision plans, hints) ─────────
# Optional. Leave LLM_PROVIDER=disabled to skip AI features entirely.
LLM_PROVIDER=disabled                          # anthropic | gemini | disabled
LLM_API_KEY=                                   # Required when LLM_PROVIDER != disabled
LLM_MODEL=claude-sonnet-4-6
LLM_BASE_URL=
LLM_TIMEOUT=30s

# ─── Payments (optional) ──────────────────────────────────────────────────────
# Each gateway is independently optional, but production has no stub
# fallback — leave both unset only if paid courses aren't in use yet. A
# gateway's webhook secret is required the moment its secret key is set.
STRIPE_SECRET_KEY=                             # Optional — sk_live_...
STRIPE_PUBLISHABLE_KEY=                        # Optional — pk_live_...
STRIPE_WEBHOOK_SECRET=                         # Required once STRIPE_SECRET_KEY is set — whsec_...
RAZORPAY_KEY_ID=                               # Optional — rzp_live_...
RAZORPAY_KEY_SECRET=                           # Optional
RAZORPAY_WEBHOOK_SECRET=                       # Required once RAZORPAY_KEY_ID is set
PAYMENTS_DEFAULT_PROVIDER=                     # Optional — "stripe" or "razorpay"
PAYMENTS_CURRENCY=USD                          # Optional — default USD

# ─── Optional features ────────────────────────────────────────────────────────
MAXMIND_DB_PATH=/app/GeoLite2-City.mmdb        # Optional — mount the file into the backend container
