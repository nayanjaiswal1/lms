# ─────────────────────────────────────────────
# MindForge frontend environment
# Copy to .env.local and fill in. NEXT_PUBLIC_* values are exposed to the browser.
#
# docker-compose.dev.yml puts every dev service behind one Caddy origin
# (Caddyfile.dev) — only Caddy publishes a host port. The frontend container
# talks to the backend directly over the compose network; the browser talks
# to everything through Caddy on http://localhost.
# ─────────────────────────────────────────────

# Server-to-server backend URL — used in server actions and route handlers.
# This is NOT exposed to the browser (no NEXT_PUBLIC_ prefix). Direct
# container-to-container hop on the compose network, no Caddy involved.
BACKEND_URL=http://backend:8080

# Public origin of the Go backend API, sent to the browser. Left empty on
# purpose: with Caddy fronting everything on one origin, the browser calls
# the API same-origin (`${API}/api/...` in lib/client/api.ts resolves to a
# relative `/api/...`) and Caddyfile.dev's /api/* rule routes it to the
# backend. Set this to a real absolute origin only for a tunnel/another-device
# setup where the browser isn't on the same host as Caddy.
NEXT_PUBLIC_API_URL=

# AI Connector (MCP) public URL shown on Settings -> Integrations. Must match
# backend/.env's MCP_PUBLIC_URL — both go through Caddy on the single port.
MCP_PUBLIC_URL=http://localhost

# Public origin of this Next.js app (metadataBase for OG/canonical tags,
# certificate verification links, assessment batch links). Same Caddy origin
# as everything else here — the frontend container doesn't publish its own port.
NEXT_PUBLIC_APP_URL=http://localhost

# Public origin user-uploaded media (avatars, etc.) is served from — must match
# the backend's MINIO_PUBLIC_ENDPOINT. Routed through Caddy's /mindforge/*
# proxy (Caddyfile.dev); minio doesn't publish its own port either.
NEXT_PUBLIC_MEDIA_URL=http://localhost

# Lab proxy WebSocket URL, exposed to the browser for terminal connections and
# the live-preview iframe. Routed through Caddy's /lab-ws/* prefix-stripped
# proxy — labproxy doesn't publish its own port either.
NEXT_PUBLIC_LAB_PROXY_URL=ws://localhost/lab-ws

# Anthropic API key — used server-side only for resume parsing (never exposed to browser)
ANTHROPIC_API_KEY=

# Social login button visibility. Set to "true" only once the matching
# GOOGLE_CLIENT_ID/GITHUB_CLIENT_ID + secret are set in backend/.env — these
# don't carry the actual client ID (not needed client-side, the button just
# links to /api/auth/<provider>), they only decide whether that provider's
# button is shown enabled or disabled/grayed-out.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=false
