# ─────────────────────────────────────────────
# MindForge frontend environment
# Copy to .env.local and fill in. Full rationale for every variable: see ../ENV_VARS.md
# ─────────────────────────────────────────────

BACKEND_URL=http://backend:8080                # Server-to-server only, not sent to browser

NEXT_PUBLIC_API_URL=                           # Optional — leave empty for single-Caddy-origin dev

MCP_PUBLIC_URL=http://localhost                # Must match backend/.env's MCP_PUBLIC_URL

NEXT_PUBLIC_APP_URL=http://localhost

NEXT_PUBLIC_MEDIA_URL=http://localhost         # Must match backend's MINIO_PUBLIC_ENDPOINT

NEXT_PUBLIC_LAB_PROXY_URL=ws://localhost/lab-ws

ANTHROPIC_API_KEY=                             # Server-side only, never exposed to browser

NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false         # Button visibility only, see ../ENV_VARS.md
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=false
