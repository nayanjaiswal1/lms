# ══════════════════════════════════════════════════════════════════════════════
# MindForge — Development Environment Variables
# Copy this file to .env and fill in all required values before running make dev
# Full rationale for every variable: see ENV_VARS.md
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=mindforge                        # Required
POSTGRES_PASSWORD=change_me_strong_password    # Required
POSTGRES_DB=mindforge_dev                      # Required
DATABASE_URL=postgres://mindforge:change_me_strong_password@localhost:5432/mindforge_dev    # Required

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0             # Required
REDIS_PASSWORD=                                # Optional in dev; required in prod

# ─── Code execution (coding-question auto-grading) ─────────────────────────────
JUDGE0_URL=                                    # Optional — e.g. http://localhost:2358
JUDGE0_TOKEN=                                  # Optional
JUDGE0_TIMEOUT=30s                             # Optional — default 30s

# ─── JWT / Session ────────────────────────────────────────────────────────────
JWT_SECRET=change_me_min_32_chars_random_secret_replace_this_value    # Required
COOKIE_SECRET=change_me_min_32_chars_random_secret_replace_this_too   # Required
ENCRYPTION_KEY=change_me_exactly_32bytes_AES256_key_replace_this!!    # Required

ACCESS_TOKEN_TTL=15m                           # Optional — default 15m
REFRESH_TOKEN_TTL=720h                         # Optional — default 720h
PASSWORD_RESET_TTL=30m                         # Optional — default 30m
EMAIL_VERIFICATION_TTL=24h                     # Optional — default 24h

# ─── Tenant ───────────────────────────────────────────────────────────────────
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001    # Required

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                              # Optional
GOOGLE_CLIENT_SECRET=                          # Optional
GITHUB_CLIENT_ID=                              # Optional
GITHUB_CLIENT_SECRET=                          # Optional
FRONTEND_URL=http://localhost:3000             # Required

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=localhost                            # Required
SMTP_PORT=1025                                 # Optional — default 587
SMTP_USER=                                     # Required in prod
SMTP_PASS=                                     # Required in prod
EMAIL_FROM=noreply@mindforge.dev               # Optional

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080                                      # Optional — default 8080
ENV=development                                # Optional — development | staging | production

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080      # Required
NEXT_PUBLIC_APP_URL=http://localhost:3000      # Required
BACKEND_URL=http://localhost:8080              # Optional

# ─── Payments (optional) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                             # Optional
STRIPE_PUBLISHABLE_KEY=                        # Optional
STRIPE_WEBHOOK_SECRET=                         # Required once STRIPE_SECRET_KEY is set
RAZORPAY_KEY_ID=                               # Optional
RAZORPAY_KEY_SECRET=                           # Optional
RAZORPAY_WEBHOOK_SECRET=                       # Required once RAZORPAY_KEY_ID is set
PAYMENTS_DEFAULT_PROVIDER=                     # Optional — stripe | razorpay
PAYMENTS_CURRENCY=USD                          # Optional — default USD
