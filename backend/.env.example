# ══════════════════════════════════════════════════════════════════════════════
# MindForge Backend — Environment Variables
# Copy to backend/.env for running the Go server outside of Docker.
# Subset of the root .env.example. Full rationale for every variable: see ../ENV_VARS.md
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://mindforge:change_me_strong_password@localhost:5432/mindforge_dev    # Required

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0             # Required

# ─── JWT / Session ────────────────────────────────────────────────────────────
JWT_SECRET=change_me_min_32_chars_random_secret_replace_this_value    # Required
COOKIE_SECRET=change_me_min_32_chars_random_secret_replace_this_too   # Required
ENCRYPTION_KEY=change_me_exactly_32bytes_AES256_key_replace_this!!    # Required

ACCESS_TOKEN_TTL=15m                           # Optional — default 15m
REFRESH_TOKEN_TTL=720h                         # Optional — default 720h
PASSWORD_RESET_TTL=30m                         # Optional — default 30m
EMAIL_VERIFICATION_TTL=24h                     # Optional — default 24h

# ─── Tenant ───────────────────────────────────────────────────────────────────
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001    # Required

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                              # Optional
GOOGLE_CLIENT_SECRET=                          # Optional
GITHUB_CLIENT_ID=                              # Optional
GITHUB_CLIENT_SECRET=                          # Optional
FRONTEND_URL=http://localhost:3000             # Required
CORS_EXTRA_ORIGINS=http://localhost            # Optional — comma-separated extra allowed origins (e.g. the Caddy dev proxy)

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=localhost                            # Required
SMTP_PORT=1025                                 # Optional — use 1025 for local Mailpit
SMTP_USER=                                     # Optional in dev
SMTP_PASS=                                     # Optional in dev
EMAIL_FROM=noreply@mindforge.dev               # Optional
EMAIL_FROM_NAME=MindForge                      # Optional
DEV_EMAIL_ALLOWLIST=                           # Optional — comma-separated addresses

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080                                      # Optional — default 8080
ENV=development                                # Optional

# ─── Code Execution ───────────────────────────────────────────────────────────
PISTON_URL=http://localhost:2000               # Optional — self-hosted Piston instance
PISTON_TIMEOUT=30s                             # Optional — default 30s
JUDGE0_URL=                                    # Optional — fallback when PISTON_URL is unset
JUDGE0_TOKEN=                                  # Optional
JUDGE0_TIMEOUT=30s                             # Optional — default 30s

# ─── Lab Proxy ────────────────────────────────────────────────────────────────
LABPROXY_PORT=8081                             # Optional — default 8081
LABPROXY_DB_URL=postgres://mindforge:change_me_strong_password@localhost:5432/mindforge_dev  # Required
LABPROXY_REDIS_URL=redis://localhost:6379/0    # Optional — default redis://localhost:6379/0
LABPROXY_JWT_SECRET=change_me_min_32_chars_random_secret_replace_this_value    # Required — must match JWT_SECRET
LABPROXY_JWT_ISSUER=mindforge-labproxy         # Optional — default mindforge-labproxy
# Live preview subdomains (p<port>-<sessionID>.<this>) — required, fatal at
# boot if unset. "localhost" works for running `go run ./cmd/labproxy`
# directly against a browser on the same machine. See ../ENV_VARS.md.
LABPROXY_PREVIEW_DOMAIN=localhost              # Required

# ─── Payments (optional) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                             # Optional
STRIPE_PUBLISHABLE_KEY=                        # Optional
STRIPE_WEBHOOK_SECRET=                         # Required once STRIPE_SECRET_KEY is set
RAZORPAY_KEY_ID=                               # Optional
RAZORPAY_KEY_SECRET=                           # Optional
RAZORPAY_WEBHOOK_SECRET=                       # Required once RAZORPAY_KEY_ID is set
PAYMENTS_DEFAULT_PROVIDER=                     # Optional — stripe | razorpay
PAYMENTS_CURRENCY=INR                          # Optional — default INR
COUPON_RATE_LIMIT_MAX=10                       # Optional
COUPON_RATE_LIMIT_WINDOW=1m                    # Optional

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
LLM_PROVIDER=disabled                          # Optional — anthropic | gemini | disabled
LLM_API_KEY=                                   # Required once LLM_PROVIDER is not disabled
LLM_MODEL=                                     # Optional — provider default
LLM_BASE_URL=                                  # Optional
LLM_TIMEOUT=30s                                # Optional — default 30s

# ─── Nightly AI Revision Digest ────────────────────────────────────────────────
LLM_COST_INPUT_PER_MTOK=0.30                   # Optional — $ per 1M input tokens
LLM_COST_OUTPUT_PER_MTOK=2.50                  # Optional — $ per 1M output tokens
DIGEST_USER_MONTHLY_BUDGET_USD=0.50            # Optional
DIGEST_GLOBAL_MONTHLY_BUDGET_USD=50.00         # Optional
