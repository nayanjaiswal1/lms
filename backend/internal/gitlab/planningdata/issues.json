      "id": 104,
      "title": "Fix login issue: JWT token expired signature validation",
      "status": "Open",
      "status_icon": "critical",
      "status_title": "Critical Issue / Open",
      "quadrant": "do_now",
      "labels": [
        { "text": "~bug", "tone": "error" },
